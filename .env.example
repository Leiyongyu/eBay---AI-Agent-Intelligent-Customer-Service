# =====================================================================
# eBay 智能客服 Agent 配置模板（开发方案第 15.2 节）
# 首次运行 main.py 会把本文件复制为 .env；真实 .env 不要提交到仓库。
# 空值 = 未配置。模型相关字段没有内置默认值，未填写时系统显示 AGENT_NOT_READY，
# 消息接入和人工队列照常运行，只是不生成 AI 草稿。
# =====================================================================

# ---------------- LLM：人工填写，不内置模型默认值 ----------------
# 回复模型只支持 openai_compatible：阿里云百炼千问兼容模式等兼容 Chat Completions 的服务（用 API Key）；ChatGPT 账号（Codex）通道已移除
LLM_PROVIDER=
# 例：百炼北京地域通用地址 https://dashscope.aliyuncs.com/compatible-mode/v1（Key 与地址须同一地域）；OpenAI 官方可留空
#   也可用百炼的业务空间专属域名 https://<业务空间ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1（可选，官方称更稳定）
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_API_KEY=
# 模型上下文窗口与最大输出 token（按所选模型填写；输出留空时按 2000 计算预算）
LLM_CONTEXT_WINDOW=
LLM_MAX_OUTPUT_TOKENS=
# 可选：留空则不向服务商传 temperature
LLM_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
# 结构化输出方式：prompt_json（最兼容，提示词约束 + Pydantic 校验）/ json_mode / json_schema / function_calling
# 是否支持后三种需按所选服务商实测（第 14.4 节），不确定时用 prompt_json
LLM_STRUCTURED_OUTPUT=prompt_json
# 可选：原样透传给服务商的额外请求参数（JSON 对象），例：百炼混合思考模型关闭思考 {"enable_thinking": false}
LLM_EXTRA_BODY=

# ---------------- Embedding：独立填写，不继承 LLM 配置 ----------------
# 知识库检索（RAG）用：上传知识库时生成条款向量、回复时向量化买家问题；KNOWLEDGE_MODE=retrieval 时必填
# 目前支持 openai_compatible
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# 必须与模型实际输出一致；pgvector 的 vector 类型 HNSW 索引最多 2000 维
EMBEDDING_DIMENSION=
EMBEDDING_DISTANCE=cosine
EMBEDDING_NORMALIZE=false

# ---------------- P4 视觉模型：暂未使用可留空 ----------------
VISION_PROVIDER=
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
# 是否用视觉模型读图（按图片计费，默认关闭；关闭时附件只给审核员看，带图来信一律人工审核）
VISION_ENABLED=false
VISION_TIMEOUT_SECONDS=60
# 每个回复任务最多识别几张图（同一张图按哈希复用结果，不重复计费）
VISION_MAX_IMAGES_PER_JOB=3

# ---------------- 买家附件（第 20 章） ----------------
# 保存目录（相对项目根目录，已在 .gitignore 的 data/ 下）；只保存校验后去掉 EXIF、重新编码的副本
MEDIA_DIR=data/media
MEDIA_MAX_BYTES=10000000
MEDIA_MAX_PER_MESSAGE=5
# 保存副本的最长边（像素），超出等比缩小
MEDIA_MAX_DIMENSION=2048
# 只从这些域名（含子域名）下载 eBay 附件，必须 HTTPS
MEDIA_ALLOWED_HOSTS=ebayimg.com,ebay.com,ebaystatic.com
# 附件副本保留天数，到期删除文件（与聊天记录保留期一致）
MEDIA_RETENTION_DAYS=30

# ---------------- 基础设施 ----------------
# 本系统数据库。留空 = 本地开发用 SQLite（data/app.db），零安装即可运行；
# PostgreSQL 例：postgresql+psycopg://postgres@127.0.0.1:5432/ebay_cs_agent（库不存在时启动自动创建）
DATABASE_URL=
# 数据库密码单独填（不要写进 DATABASE_URL），特殊字符无需转义
DATABASE_PASSWORD=
# 现有 MySQL 业务库只读账号（BUSINESS_SOURCE=mysql 时使用，当前尚未实现）
BUSINESS_MYSQL_URL=
# Redis：只做 Worker 唤醒等辅助，不存业务数据；连不上时自动退回进程内唤醒。例：redis://127.0.0.1:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=ebaycs:
# 可选：本机 redis-server.exe 路径。REDIS_URL 指向本机且连不上时，启动类会自动拉起它
REDIS_AUTOSTART_PATH=
VECTOR_STORE_BACKEND=pgvector

# 业务数据源：fixture = 演示数据（backend/data/demo/business_fixtures.json）；mysql = 现有业务库（待实现）
BUSINESS_SOURCE=fixture
# eBay 收发渠道：mock = 本地模拟渠道（不连 eBay）；ebay = 真实渠道（待接入现有收发代码）
EBAY_CHANNEL=mock
# 启动时导入的知识库（JSONL，一行一个条款）和演示数据；已导入的条款按 content_hash 跳过
# 留空 = 不导入（推荐）。正式知识库在工作台“知识库”页上传 Excel 维护
KNOWLEDGE_SEED_FILE=
DEMO_SEED=true

# ---------------- eBay 消息拉取（只读，Commerce Message API）----------------
# 只调用 getConversations / getConversation 两个读取接口，本系统不会向 eBay 发送任何消息。
# production 正式环境 / sandbox 沙箱；App ID、Cert ID、令牌必须来自同一环境
EBAY_ENV=production
# 开发者后台 Application Keys 里的 App ID（Client ID）与 Cert ID（Client Secret）
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Dev ID：Message API 用不到，留作以后 Trading API 备用，可不填
EBAY_DEV_ID=
# 店铺授权给本应用的 OAuth refresh token（以 v^1.1# 开头，授权时须勾选 commerce.message 权限）。
# 注意：以 AgAAAA 开头的是 Auth'n'Auth 旧令牌，Message API 不接受
EBAY_REFRESH_TOKEN=
# 可选：只想临时测试时，可填 OAuth 用户访问令牌（约 2 小时过期，过期后需重填）
EBAY_USER_ACCESS_TOKEN=
# 本系统内部给这个店铺起的 ID、名称、默认站点与时区
EBAY_STORE_ID=EBAY_STORE_1
EBAY_STORE_NAME=
EBAY_STORE_MARKETPLACE=EBAY_US
# 店铺开通的站点（逗号分隔）。会话站点按关联刊登查出；eBay Motors（EBAY_MOTORS_US）归为美国站
EBAY_STORE_MARKETPLACES=EBAY_US,EBAY_DE,EBAY_GB
EBAY_STORE_TIMEZONE=America/Los_Angeles
# 店铺自己的 eBay 用户名；留空时从多个会话的共同参与方自动推断（只有 1 个会话时推断不出）
EBAY_SELLER_USERNAME=
# 凭证齐全时启动后每隔多少秒自动拉取一次；首次只回溯最近几天
# 测试期用：工作台显示“删除会话（测试）”和“清空测试会话”，只能删测试会话（eBay 拉取的真实会话不能删）；正式上线前改 false 并移除
TEST_DELETE_ENABLED=false
EBAY_SYNC_ENABLED=true
EBAY_SYNC_INTERVAL_SECONDS=300
EBAY_SYNC_LOOKBACK_DAYS=7
# 只同步这些店铺（系统店铺 ID 或 eBay 账号，逗号分隔）；留空为店铺凭证表里全部 eBay 店铺
EBAY_SYNC_STORES=
# 拉到的买家消息是否交给 AI 生成草稿。默认 false：合规确认（方案第 7 章 Q6）前不把真实买家消息发给模型
EBAY_SYNC_CREATE_REPLY_JOBS=false

# ---------------- 聊天记录保留期 ----------------
# 每个店铺只保留最近 N 天的聊天记录（按消息在 eBay 的发送时间），更早的消息、附件文件、回复任务与草稿每天轮询清理；
# 拉取时也不再入库早于 N 天的消息。店铺可在 stores.retention_days 单独设置。0 = 不清理
DATA_RETENTION_DAYS=30
# 每天几点清理（本机时间）；当时没开机的话，下次启动后补跑
RETENTION_CLEANUP_TIME=03:30
RETENTION_BATCH_SIZE=500
# true = 试运行，只统计会删多少不真删；在系统状态页确认数字后改为 false
RETENTION_DRY_RUN=true
# 审计日志（只有操作记录、不含聊天正文）保留天数
AUDIT_RETENTION_DAYS=180

# eBay 账号删除通知（第 8.1、18.2 节）。公网部署时填写
EBAY_VERIFICATION_TOKEN=
# eBay 实时推送接收地址（公网 HTTPS，经 Cloudflare 隧道转到本机）；挑战校验与 EBAY_VERIFICATION_TOKEN（32–80 位字母数字）共用
EBAY_NOTIFY_ENDPOINT=
# Cloudflare 隧道跟着 main.py 启停：两项都填才启动；令牌在 Cloudflare 隧道页的安装命令里（service install 后面那串），只放这里，不要发给别人
CLOUDFLARED_PATH=
CLOUDFLARE_TUNNEL_TOKEN=
EBAY_DELETION_ENDPOINT=

# ---------------- 发票（PDF 留底 + 企业邮箱发送） ----------------
# 每份生成的发票 PDF 都存到这里留底（只有管理员能看），不随聊天记录清理
INVOICE_DIR=data/invoices
# 买家在消息里给了邮箱、且能确定是哪笔订单时，先自动生成发票，等人工审核后再发
INVOICE_AUTO_GENERATE=true
# 发票字体（TTF）；留空用 Windows 自带 Arial
INVOICE_PDF_FONT=
# false = 只模拟发送（记录但不真正发邮件）；SMTP 配好、在“发票”页发测试邮件成功后再改 true
INVOICE_MAIL_ENABLED=false
# 企业微信邮箱（腾讯企业邮）：smtp.exmail.qq.com，SSL 465；密码填企业邮箱里生成的“客户端专用密码”，只放这里
INVOICE_SMTP_HOST=smtp.exmail.qq.com
INVOICE_SMTP_PORT=465
INVOICE_SMTP_USER=
INVOICE_SMTP_PASSWORD=
INVOICE_MAIL_FROM_NAME=
# 每封发票邮件密送一份到这个邮箱（可空）
INVOICE_MAIL_BCC=

# ---------------- 售后邮箱（买家发来的照片/视频） ----------------
# 账号和客户端专用密码填好、邮箱里开启 IMAP 后改 true；每 AFTERSALES_MAIL_POLL_SECONDS 秒收一次
AFTERSALES_MAIL_ENABLED=false
AFTERSALES_IMAP_HOST=imap.exmail.qq.com
AFTERSALES_IMAP_PORT=993
AFTERSALES_MAIL_USER=
AFTERSALES_MAIL_PASSWORD=
# 收件文件夹；处理完移到“已处理”（没有会自动建）
AFTERSALES_MAIL_FOLDER=INBOX
AFTERSALES_MAIL_DONE_FOLDER=已处理
AFTERSALES_MAIL_POLL_SECONDS=300
# AI 可以把售后邮箱告诉买家（请买家发视频、大文件，邮件主题写订单号）
AFTERSALES_MAIL_SHARE_WITH_BUYERS=true
# 附件按店铺存放；单个文件上限（MB）；文件和“已处理”邮件保留天数；每天清理时间
AFTERSALES_FILES_DIR=data/after_sales_files
AFTERSALES_FILE_MAX_MB=2048
AFTERSALES_RETENTION_DAYS=30
AFTERSALES_CLEANUP_TIME=04:00
# 用 Windows Defender 扫描保存的文件
AFTERSALES_VIRUS_SCAN=true

# ---------------- 买家上传页（upload.diwhx.xyz，大视频直传 Cloudflare R2） ----------------
# R2、Turnstile 配好、隧道加了 upload 子域名后改 true；配置步骤见 docs/上传页_Cloudflare配置步骤.md
UPLOAD_PAGE_ENABLED=false
UPLOAD_PUBLIC_URL=https://upload.diwhx.xyz
# R2：账号 ID、只读写这个存储桶的 API 令牌、私有存储桶名（密钥只放这里）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Turnstile 人机验证（站点密钥给页面用，私密密钥只在服务端）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 每个订单最多上传 5GB、最多 20 个文件；客服生成的上传链接 7 天有效；买家校验后会话 12 小时；分块 16MB
UPLOAD_ORDER_MAX_GB=5
UPLOAD_MAX_FILES=20
UPLOAD_LINK_DAYS=7
UPLOAD_SESSION_HOURS=12
UPLOAD_PART_MB=16
# 上传链接签名密钥；留空用 CREDENTIALS_MASTER_KEY 派生
UPLOAD_LINK_SECRET=

# ---------------- 本系统运行边界 ----------------
# fixed_pipeline 或 planner_loop（planner_loop 为 P3 内容，当前未实现，选它会显示未就绪）
AGENT_MODE=fixed_pipeline
# full_context：适用条款全部塞进提示；retrieval：pgvector 向量 + 全文 + SKU 混合检索，只取最相关的几条（需装 pgvector）
KNOWLEDGE_MODE=full_context
# 单店铺单站点可对买家说的条款合计 token 上限（全量注入模式）；上传知识库时会按站点提示是否超出
KNOWLEDGE_FULL_CONTEXT_MAX_TOKENS=12000
# 检索模式：最终放进提示的条款数、每一路（向量/全文）召回的候选数、检索条款合计 token 上限
KNOWLEDGE_RETRIEVAL_TOP_K=6
KNOWLEDGE_RETRIEVAL_CANDIDATES=20
KNOWLEDGE_RETRIEVAL_MAX_TOKENS=6000
# 应用侧输入预算（第 15.5 节）；实际取它与 LLM_CONTEXT_WINDOW - 输出预留 中的较小值
AGENT_INPUT_BUDGET_TOKENS=20000
# 知识生效日期覆盖（YYYY-MM-DD），用于测试未来生效条款；留空 = 今天
KNOWLEDGE_DATE_OVERRIDE=
MESSAGE_MERGE_WINDOW_SECONDS=180
AGENT_MAX_TOOL_REQUESTS=5
AGENT_PREFETCH_MAX_TOOL_CALLS=8
AGENT_MAX_REPLANS=2
AGENT_MAX_OUTPUT_REPAIRS=1
AGENT_DEADLINE_SECONDS=45
# AI 自动回复总开关：开启后，打开了“AI 自动回复”的店铺，通过闸门（知识库有依据、低风险、合规）的回复自动发出（只读阶段为模拟发送）
AUTO_SEND_ENABLED=false
# 可自动发送的意图白名单（逗号分隔）：商品参数、物流进度、如何下单、致谢
AUTO_SEND_INTENTS=
# 只向买家索要资料（action=clarify）时也可自动发的 L1 意图，如 fitment：适配咨询先要 VIN；给出适配结论的仍要人工
AUTO_SEND_CLARIFY_INTENTS=
# 按当前商品信息（模型按需查询 get_item_details）作答时也可自动发的意图：商品参数、运费、发货时效；适配结论不在其中
AUTO_SEND_LISTING_INTENTS=
# 白名单为 * 时仍要人工的意图（逗号分隔）：fitment 适配结论（只索要 VIN 的追问不受影响）、price_offer 议价
AUTO_SEND_EXCLUDE_INTENTS=
# 自动发送允许的最高风险：L0 或 L1；L2/L3（退款、取消、改地址、破损错发、评价、站外、纠纷法律）永远转人工
AUTO_SEND_MAX_RISK=L0
# 依据要求：kb 必须引用知识库条款；any 引用任一依据（知识库、商品信息、订单物流等查询结果），或回复里没有事实陈述（寒暄、请买家补充信息）
AUTO_SEND_EVIDENCE=kb
# 同一会话 AI 最多连续自动回复几次，达到后买家再来信交人工
AUTO_REPLY_MAX_STREAK=1
# 合规外链白名单之外再追加的域名（逗号分隔），eBay 与常见承运商域名已内置
COMPLIANCE_EXTRA_URL_WHITELIST=

# ---------------- 本地服务 ----------------
APP_HOST=127.0.0.1
APP_PORT=8000
# 启动后自动打开浏览器
APP_OPEN_BROWSER=true
# 前端源码有改动时，启动前自动 npm install / npm run build
FRONTEND_AUTO_BUILD=true
WORKER_POLL_SECONDS=2
# 工作台认领锁有效期（第 5.1 节，默认 10 分钟）
CLAIM_TTL_SECONDS=600
LOG_LEVEL=INFO

# ---------------- 飞书导出（临时工具 scripts/feishu_export.py） ----------------
# 企业自建应用的凭证，在飞书开放平台“凭证与基础信息”页查看
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 国内版飞书 https://open.feishu.cn；海外版 Lark 改为 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn
# 只导出指定群（逗号分隔 chat_id，形如 oc_xxx）；留空则导出机器人所在的全部群
FEISHU_CHAT_IDS=
# 按群名关键字筛选，如：售后
FEISHU_CHAT_NAME_KEYWORD=
# 可选时间范围（YYYY-MM-DD），留空为全部历史
FEISHU_START_DATE=
FEISHU_END_DATE=
# 是否下载图片、文件、语音、视频
FEISHU_DOWNLOAD_FILES=true
# 测试用：每个群（和每个话题）最多拉取多少条，从最早的消息开始；留空为不限
FEISHU_MAX_MESSAGES=
# 导出目录，相对路径以项目根目录为准；默认 data/feishu_export（已在 .gitignore 中）
FEISHU_EXPORT_DIR=data/feishu_export

# ---------------- 飞书售后知识整理（scripts/feishu_kb_build.py） ----------------
# 运行哪些阶段（逗号分隔）：build 拼接脱敏 / extract 模型提炼 / clauses 起草条款 / review 生成审核表 / import 导入审核通过的条款
FEISHU_KB_STAGES=build,extract,clauses,review
# 试点：只提炼多少个案例（按产品线分层随机抽取）；留空为全量
FEISHU_KB_LIMIT=
# 技术支持的姓名（逗号分隔），脱敏后标为“技术支持”，其他人标为“客服”
FEISHU_KB_TECH_NAMES=
# 模型并发数
FEISHU_KB_PARALLEL=4
# 脱敏哈希的盐：留空时首次运行自动生成并写回 .env，之后不要修改
FEISHU_KB_HASH_SALT=
# import 阶段读取的审核表（相对项目根目录）；留空取 FEISHU_KB_DIR 下最新的 review_*.xlsx
FEISHU_KB_REVIEW_FILE=
# 输出目录，默认 data/feishu_kb（已在 .gitignore 中）
FEISHU_KB_DIR=data/feishu_kb

# ---------------- 店铺凭证（加密存库，scripts/import_store_credentials.py 整表覆盖导入） ----------------
# 紫鸟店铺全量 Excel 的路径（第一行表头：序号、店铺名称、平台、店铺账号、店铺IP、IP已过期、browserId、站点ID、秘钥）
STORE_CREDENTIALS_FILE=
# 加密主密钥（Base64 的 32 字节）：留空时首次导入自动生成并写回这里。只在 .env，不入库；请另外备份，丢失后无法解密
CREDENTIALS_MASTER_KEY=

# OAuth 授权跳转名（eBay 开发者后台 User Tokens 页的 RuName），重新授权店铺时用
EBAY_RUNAME=

# ---------------- 谷仓海外仓 OMS（只读：按 eBay 订单号查出库单、物流号） ----------------
GOODCANG_ENDPOINT=https://oms.goodcang.net/public_open
GOODCANG_APP_TOKEN=
GOODCANG_APP_KEY=
# 谷仓按密钥限流：相邻请求最小间隔（毫秒）
GOODCANG_MIN_REQUEST_INTERVAL_MS=1200


# ---------------- 17TRACK 物流轨迹（v2.4；每个新物流号注册时扣 1 单额度，查详情不扣） ----------------
# 填好密钥后把 TRACK17_ENABLED 改为 true；密钥在 17TRACK API 后台“设置”页获取，只放这里
TRACK17_ENABLED=false
TRACK17_API_KEY=
# 同一物流号多久内直接用缓存（分钟）；17TRACK 本身每 6–12 小时更新一次
TRACK17_CACHE_MINUTES=120
# 每天最多新注册多少个物流号（防止额度被刷光）
TRACK17_REGISTER_DAILY_LIMIT=50
# 新注册后等轨迹返回的最长秒数，超时先回复基本信息
TRACK17_WAIT_SECONDS=12

# ---------------- 物流判断与谷仓查件单 ----------------
# 只看“轨迹多少天没更新”：满 STALL 天转人工跟进；满 RESHIP 天标“物流超时需判断补发”（补发由人工决定）
LOGISTICS_STALL_DAYS=4
LOGISTICS_RESHIP_DAYS=7
# 每天几点同步谷仓查件单（本机时间；没开机的启动后补跑），同步最近多少天创建的（最多 186）
LOGISTICS_TICKET_SYNC_TIME=10:00
LOGISTICS_TICKET_SYNC_DAYS=30
# 物流需人工（断更、异常、妥投未收到）时自动在谷仓“保存”查件单草稿（不提交），客服在谷仓后台核对后提交
LOGISTICS_TICKET_AUTO_DRAFT=false
# 查件单通知邮箱（谷仓必填，最多 10 个，逗号分隔）
LOGISTICS_TICKET_NOTIFY_EMAILS=
